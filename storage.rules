rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Post media — uploaded by post authors at create time.
    match /forum-posts/{forumSlug}/{postSlug}/{filename} {
      allow read: if request.auth != null;
      // Any signed-in user can upload images (we trust the client gate that
      // they're attaching to their own post; for stricter checks we'd need a
      // Cloud Function or server-side validation).
      allow create: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
