rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user profile docs. UID-keyed; only the owner can write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Username -> uid index, used to allow logging in by username.
    // Public read so the login page can resolve username -> email lookup
    // through the users collection query (which requires auth, but creation
    // of the username doc itself happens at signup, just after auth).
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
